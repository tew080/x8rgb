From 0000000000000000000000000000000000000004 Mon Sep 17 00:00:00 2001
From: x8rgb dev <dev@x8rgb.local>
Date: Sun, 15 Nov 2026 14:10:00 +0700
Subject: [PATCH] Single-home UI: notif color, music colors/effects, bass blink

Drop Rules and Settings tabs. Home owns:
- global notification color + effect
- music palette mode, effect, bass-reactive blink
Listener uses global notif settings. Service music path uses bass blink when enabled.
---
diff --git a/app/src/main/java/com/example/x8rgb/data/db/entity/AppSettingsEntity.kt b/app/src/main/java/com/example/x8rgb/data/db/entity/AppSettingsEntity.kt
--- a/app/src/main/java/com/example/x8rgb/data/db/entity/AppSettingsEntity.kt
+++ b/app/src/main/java/com/example/x8rgb/data/db/entity/AppSettingsEntity.kt
@@ -18,3 +18,10 @@
     /** Always-on effect while idle. EffectEngine.EFFECT_STATIC = solid base only. */
     val ambientEffectId: Int           = 10, // EffectEngine.EFFECT_STATIC
+    // Global notification look (all apps)
+    val notifColorPacked: Long         = 0xFF000082L, // red
+    val notifEffectId: Int             = 10, // static
+    // Music visual
+    val musicColorPacked: Long         = 0x00FF0082L, // green seed
+    val musicEffectId: Int             = 0,  // rainbow-ish default via FFT unless bass
+    val musicBassBlink: Boolean        = true,
 )
diff --git a/app/src/main/java/com/example/x8rgb/data/db/AppDatabase.kt b/app/src/main/java/com/example/x8rgb/data/db/AppDatabase.kt
--- a/app/src/main/java/com/example/x8rgb/data/db/AppDatabase.kt
+++ b/app/src/main/java/com/example/x8rgb/data/db/AppDatabase.kt
@@ -15,5 +15,5 @@
         AppSettingsEntity::class,
     ],
-    version  = 3,
+    version  = 4,
     exportSchema = true,
 )
diff --git a/app/src/main/java/com/example/x8rgb/data/repository/SettingsRepository.kt b/app/src/main/java/com/example/x8rgb/data/repository/SettingsRepository.kt
--- a/app/src/main/java/com/example/x8rgb/data/repository/SettingsRepository.kt
+++ b/app/src/main/java/com/example/x8rgb/data/repository/SettingsRepository.kt
@@ -60,4 +60,16 @@
     suspend fun updateAmbientEffect(effectId: Int) {
         dao.upsert(get().copy(ambientEffectId = effectId))
     }
+
+    suspend fun updateNotifLook(colorPacked: Long, effectId: Int) {
+        dao.upsert(get().copy(notifColorPacked = colorPacked, notifEffectId = effectId))
+    }
+
+    suspend fun updateMusicLook(colorPacked: Long, effectId: Int, bassBlink: Boolean) {
+        dao.upsert(get().copy(
+            musicColorPacked = colorPacked,
+            musicEffectId = effectId,
+            musicBassBlink = bassBlink,
+        ))
+    }
 }
diff --git a/app/src/main/java/com/example/x8rgb/ui/MainViewModel.kt b/app/src/main/java/com/example/x8rgb/ui/MainViewModel.kt
--- a/app/src/main/java/com/example/x8rgb/ui/MainViewModel.kt
+++ b/app/src/main/java/com/example/x8rgb/ui/MainViewModel.kt
@@ -155,5 +155,13 @@
     fun setAmbientEffect(effectId: Int) {
         viewModelScope.launch { settingsRepository.updateAmbientEffect(effectId) }
     }
+
+    fun setNotifLook(color: RgbColor, effectId: Int) {
+        viewModelScope.launch { settingsRepository.updateNotifLook(color.packed, effectId) }
+    }
+
+    fun setMusicLook(color: RgbColor, effectId: Int, bassBlink: Boolean) {
+        viewModelScope.launch { settingsRepository.updateMusicLook(color.packed, effectId, bassBlink) }
+    }
 
     fun addAppRule(app: AppItem) {
diff --git a/app/src/main/java/com/example/x8rgb/service/RgbForegroundService.kt b/app/src/main/java/com/example/x8rgb/service/RgbForegroundService.kt
--- a/app/src/main/java/com/example/x8rgb/service/RgbForegroundService.kt
+++ b/app/src/main/java/com/example/x8rgb/service/RgbForegroundService.kt
@@ -155,3 +155,17 @@
                         settings.musicSyncEnabled && hasLight(musicColor) -> {
-                            applyColor(musicColor)
+                            val seed = RgbColor(settings.musicColorPacked).let {
+                                if (hasLight(it)) it else musicColor
+                            }
+                            val out = if (settings.musicBassBlink) {
+                                // bass energy in musicColor.r channel from FFT mapping
+                                val bass = (musicColor.r / 255f).coerceIn(0f, 1f)
+                                val k = if (bass > 0.12f) bass else 0.05f
+                                RgbColor((seed.r * k).toInt(), (seed.g * k).toInt(), (seed.b * k).toInt())
+                            } else if (settings.musicEffectId != EffectEngine.EFFECT_STATIC) {
+                                effectEngine.compute(settings.musicEffectId, tick, seed)
+                            } else {
+                                musicColor // spectrum RGB from FFT
+                            }
+                            applyColor(out)
+                            tick++
                         }
diff --git a/app/src/main/java/com/example/x8rgb/service/RgbNotificationListener.kt b/app/src/main/java/com/example/x8rgb/service/RgbNotificationListener.kt
--- a/app/src/main/java/com/example/x8rgb/service/RgbNotificationListener.kt
+++ b/app/src/main/java/com/example/x8rgb/service/RgbNotificationListener.kt
@@ -1,5 +1,6 @@
 package com.x8rgb.service
 
 import android.app.Notification
+import android.content.Context
 import android.content.ComponentName
 import android.content.Intent
@@ -35,4 +35,5 @@
     @Inject lateinit var ruleRepository: RuleRepository
     @Inject lateinit var priorityResolver: PriorityResolver
+    @Inject lateinit var settingsRepository: com.x8rgb.data.repository.SettingsRepository
 
     private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
@@ -70,7 +70,25 @@
         val key   = contactKey(notif)
         val rule  = priorityResolver.resolve(pkg, key, notif.group, cachedRules)
-            ?: return                              // no rule: leave the ring alone
-        DiagLog.log("notif", "match pkg=$pkg type=${rule.type} anim=${rule.animationId}")
-        activeStack.remove(sbn.key)                // re-post moves it to the top
-        activeStack[sbn.key] = rule
-        sendColor(rule.color, rule.animationId)
+        if (rule != null) {
+            DiagLog.log("notif", "match pkg=$pkg type=${rule.type} anim=${rule.animationId}")
+            activeStack.remove(sbn.key)
+            activeStack[sbn.key] = rule
+            sendColor(rule.color, rule.animationId)
+            return
+        }
+        // Global notif look (home setting) — any notification without a rule
+        scope.launch {
+            val s = settingsRepository.get()
+            val color = com.x8rgb.domain.model.RgbColor(s.notifColorPacked)
+            if ((color.r or color.g or color.b) == 0) return@launch
+            DiagLog.log("notif", "global notif color pkg=$pkg effect=${s.notifEffectId}")
+            activeStack.remove(sbn.key)
+            activeStack[sbn.key] = com.x8rgb.domain.model.NotificationRule(
+                type = com.x8rgb.domain.model.RuleType.APP,
+                key = pkg,
+                displayName = pkg,
+                color = color,
+                animationId = s.notifEffectId,
+            )
+            sendColor(color, s.notifEffectId)
+        }
diff --git a/app/src/main/java/com/example/x8rgb/MainActivity.kt b/app/src/main/java/com/example/x8rgb/MainActivity.kt
