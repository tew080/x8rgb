     }
 }
@@ -500,3 +500,127 @@
 }
+
+@Composable
+private fun NotifLookCard(
+    color: RgbColor,
+    effectId: Int,
+    onSave: (RgbColor, Int) -> Unit,
+) {
+    var open by remember { mutableStateOf(false) }
+    val effectName = EffectEngine.EFFECT_NAMES.getOrElse(effectId) { "Static" }
+    Card(modifier = Modifier.fillMaxWidth()) {
+        Column(modifier = Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            Text(stringResource(R.string.card_notif_title), style = MaterialTheme.typography.titleMedium)
+            Text(stringResource(R.string.hint_notif), style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.outline)
+            Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
+                Text("$effectName", style = MaterialTheme.typography.bodyLarge)
+                ColorDot(color, selected = true, size = 36.dp, onClick = { open = true })
+            }
+            TextButton(onClick = { open = true }) { Text(stringResource(R.string.btn_edit_notif)) }
+        }
+    }
+    if (open) {
+        LookEditorDialog(
+            title = stringResource(R.string.card_notif_title),
+            color = color,
+            effectId = effectId,
+            showBass = false,
+            bass = false,
+            onDismiss = { open = false },
+            onSave = { c, e, _ -> onSave(c, e); open = false },
+        )
+    }
+}
+
+@Composable
+private fun MusicLookCard(
+    enabled: Boolean,
+    color: RgbColor,
+    effectId: Int,
+    bassBlink: Boolean,
+    onEnabled: (Boolean) -> Unit,
+    onSave: (RgbColor, Int, Boolean) -> Unit,
+) {
+    var open by remember { mutableStateOf(false) }
+    val effectName = EffectEngine.EFFECT_NAMES.getOrElse(effectId) { "Static" }
+    Card(modifier = Modifier.fillMaxWidth()) {
+        Column(modifier = Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
+                Text(stringResource(R.string.card_music_title), style = MaterialTheme.typography.titleMedium)
+                Switch(checked = enabled, onCheckedChange = onEnabled)
+            }
+            Text(stringResource(R.string.hint_music), style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.outline)
+            if (enabled) {
+                Text(
+                    if (bassBlink) stringResource(R.string.label_music_bass_on)
+                    else stringResource(R.string.label_music_effect, effectName),
+                    style = MaterialTheme.typography.bodyLarge,
+                )
+                Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
+                    TextButton(onClick = { open = true }) { Text(stringResource(R.string.btn_edit_music)) }
+                    ColorDot(color, selected = true, size = 36.dp, onClick = { open = true })
+                }
+            }
+        }
+    }
+    if (open) {
+        LookEditorDialog(
+            title = stringResource(R.string.card_music_title),
+            color = color,
+            effectId = effectId,
+            showBass = true,
+            bass = bassBlink,
+            onDismiss = { open = false },
+            onSave = { c, e, b -> onSave(c, e, b); open = false },
+        )
+    }
+}
+
+@Composable
+private fun LookEditorDialog(
+    title: String,
+    color: RgbColor,
+    effectId: Int,
+    showBass: Boolean,
+    bass: Boolean,
+    onDismiss: () -> Unit,
+    onSave: (RgbColor, Int, Boolean) -> Unit,
+) {
+    var c by remember { mutableStateOf(color) }
+    var e by remember { mutableStateOf(effectId) }
+    var b by remember { mutableStateOf(bass) }
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        confirmButton = { TextButton(onClick = { onSave(c, e, b) }) { Text(stringResource(R.string.btn_save)) } },
+        dismissButton = { TextButton(onClick = onDismiss) { Text(stringResource(R.string.btn_cancel)) } },
+        title = { Text(title) },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                if (showBass) {
+                    Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
+                        Text(stringResource(R.string.label_bass_blink))
+                        Switch(checked = b, onCheckedChange = { b = it })
+                    }
+                }
+                Text(stringResource(R.string.dialog_select_color), style = MaterialTheme.typography.titleSmall)
+                HsvColorPicker(initial = c, onColorChange = { c = it }, modifier = Modifier.fillMaxWidth())
+                if (!b) {
+                    Text(stringResource(R.string.dialog_select_effect), style = MaterialTheme.typography.titleSmall)
+                    LazyColumn(modifier = Modifier.height(160.dp)) {
+                        items(EffectEngine.EFFECT_NAMES.size) { id ->
+                            Row(
+                                Modifier.fillMaxWidth().clickable { e = id }.padding(vertical = 6.dp),
+                                verticalAlignment = Alignment.CenterVertically,
+                            ) {
+                                RadioButton(selected = e == id, onClick = { e = id })
+                                Text(EffectEngine.EFFECT_NAMES[id])
+                            }
+                        }
+                    }
+                }
+            }
+        },
+    )
+}
