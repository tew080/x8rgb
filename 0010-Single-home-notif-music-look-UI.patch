@@ -168,4 +168,7 @@
     onAmbientEffect: (Int) -> Unit,
+    onNotifLook: (RgbColor, Int) -> Unit,
+    onMusicLook: (RgbColor, Int, Boolean) -> Unit,
+    onMusicSync: (Boolean) -> Unit,
     onRequestShizuku: () -> Unit,
     onGrantShizuku: () -> Unit,
     onRequestAudio: () -> Unit,
@@ -220,8 +220,23 @@
         AmbientEffectCard(
             effectId = state.settings.ambientEffectId,
             baseColor = RgbColor(state.settings.baseColorPacked),
